# @dialect: AGENTFABRIC=1.1
system:
  instructions: |
    You are Sherlock — the Recon & Discovery Agent within the KATE documentation network.
    
    Your mission: Discover ALL integration assets. If no specific app is named, scan every
    application in Anypoint Platform. For each app found:
    
    1. Scan Anypoint Platform: Use list_apis for APIs, find_assets for Exchange, list_applications for deployed apps
    2. Scan GitHub: Find linked repositories, Mule XML flows, DataWeave transforms, README files
    3. Scan GitBooks: Find any existing documentation using list_sites + get_site_structure + get_page
    4. Create ONE Linear task per app using save_issue:
       - Title: "[KATE] Document: <App Name>"
       - Description with Anypoint app name, GitHub repo links, GitBooks doc links, API list, environments
    5. Add each individual finding as a separate comment using save_comment:
       - "Sherlock — Found API: <name> in Anypoint Platform (<env>)"
       - "Sherlock — GitHub repo found: <url> | Mule files: <count>"
       - "Sherlock — Existing GitBooks docs found: <title> (<url>)"
    
    Return the full asset catalog with Linear task IDs for all downstream agents.

config:
  agent_name: "SHERLOCK"
  default_llm: @llm.omniLLM

llm:
  omniLLM:
    target: "llm://llmConnection"
    kind: "OpenAI"
    model: "gpt-5.6-luna"

actions:
  anypoint_list_apis:
    target: "mcp://sherlockAnypointDxConnection"
    kind: "mcp:tool"
    tool_name: "list_api_instances"
    inputs:
      organization_id: string
      name: string
      limit: string

  anypoint_find_assets:
    target: "mcp://sherlockAnypointApisCatalogConnection"
    kind: "mcp:tool"
    tool_name: "find_assets"
    inputs:
      query: string
      asset_type: string
      max_results: string
      user_query: string

  anypoint_list_applications:
    target: "mcp://sherlockAnypointDxConnection"
    kind: "mcp:tool"
    tool_name: "list_applications"
    inputs:
      environmentName: string
      appName: string

  anypoint_get_api_details:
    target: "mcp://sherlockAnypointApisCatalogConnection"
    kind: "mcp:tool"
    tool_name: "view_api_version_details"
    inputs:
      organization_id: string
      asset_id: string
      api_version: string
      version: string

  github_search_repos:
    target: "mcp://githubConnection"
    kind: "mcp:tool"
    tool_name: "search_repositories"
    inputs:
      query: string
      page: string
      per_page: string

  github_get_file_contents:
    target: "mcp://githubConnection"
    kind: "mcp:tool"
    tool_name: "get_file_contents"
    inputs:
      owner: string
      repo: string
      path: string

  gitbooks_list_organizations:
    target: "mcp://gitbooksConnection"
    kind: "mcp:tool"
    tool_name: "invoke_operation"
    inputs:
      operationId: string

  gitbooks_search_content:
    target: "mcp://gitbooksConnection"
    kind: "mcp:tool"
    tool_name: "invoke_operation"
    inputs:
      operationId: string
      params: string

  gitbooks_list_sites:
    target: "mcp://gitbooksConnection"
    kind: "mcp:tool"
    tool_name: "list_sites"
    inputs:
      organizationId: string
      limit: string

  gitbooks_get_structure:
    target: "mcp://gitbooksConnection"
    kind: "mcp:tool"
    tool_name: "get_site_structure"
    inputs:
      organizationId: string
      siteId: string

  gitbooks_get_page:
    target: "mcp://gitbooksConnection"
    kind: "mcp:tool"
    tool_name: "get_page"
    inputs:
      spaceId: string
      pageId: string
      path: string

  linear_list_teams:
    target: "mcp://linearConnection"
    kind: "mcp:tool"
    tool_name: "list_teams"
    inputs:
      limit: string
      query: string

  linear_save_issue:
    target: "mcp://linearConnection"
    kind: "mcp:tool"
    tool_name: "save_issue"
    inputs:
      team: string
      title: string
      description: string
      priority: string
      state: string
      issue_id: string

  linear_save_comment:
    target: "mcp://linearConnection"
    kind: "mcp:tool"
    tool_name: "save_comment"
    inputs:
      issueId: string
      body: string

trigger sherlockTrigger:
  kind: "a2a"
  target: "brokers://sherlockAgentBroker/a2a"
  on_message: ->
    transition to @echo.scanStartNotification

echo scanStartNotification:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("🔍 Sherlock is on the case. Scanning Anypoint Platform, GitHub, and GitBooks...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.anypointScan

# ─── STEP 1: Anypoint Platform Scan ────────────────────────────────────────

orchestrator anypointScan:
  description: "Scan Anypoint Platform for deployed apps, APIs, and Exchange assets"
  label: "Anypoint Platform Scan"
  system:
    instructions: |
      You are Sherlock performing Anypoint Platform discovery.
      
      If the user message names a specific environment (e.g. "Sandbox", "Production"),
      scan ONLY that environment. Otherwise scan all common environments (Sandbox, Production, Development).
      - Use anypoint_list_applications to list deployed applications (per environment)
      - Use anypoint_list_apis to list APIs registered in API Manager
      - Use anypoint_find_assets to search Exchange for related integration assets
      - Use anypoint_get_api_details for detailed information on discovered APIs

      Always set organizationId as "72aaa304-0a87-40c9-8a75-b32b686ae5f8"
      
      Do not perform unnecessary calls. If the input scopes to a specific app or environment, focus there.
      Return a complete JSON catalog of everything found on Anypoint Platform.
  reasoning:
    instructions: ->
      | Perform Anypoint Platform discovery.
        
        Input: {!@request.payload.message.parts[0].text}
        
        SCOPING RULES — read the input carefully before making any calls:
        
        IMPORTANT: NEVER filter by appName in anypoint_list_applications — app names in Runtime
        Manager can be in any format (kebab-case, camelCase, with versions, suffixes, etc.).
        Always retrieve the full list first, then match by similarity in your reasoning.
        
        CASE 1 — Input names a SPECIFIC APP (e.g. "scan order-api", "document payment-service"):
          - Call anypoint_list_applications WITHOUT appName (get ALL deployed apps)
          - From the returned list, identify apps whose name closely matches the user's input
            (partial match, case-insensitive, ignore version suffixes and environment suffixes)
          - Call anypoint_list_apis WITHOUT name filter (get all APIs)
          - From the returned APIs, identify APIs related to the matched app
          - Do NOT call anypoint_find_assets unless no apps were returned at all
          - Set apps_found = count of matched apps (typically "1" for a specific app request)
        
        CASE 2 — Input names only an ENVIRONMENT (e.g. "scan Sandbox", "scan Production"):
          - Call anypoint_list_applications with environmentName = the named environment only
            (do NOT pass appName)
          - Call anypoint_list_apis without name filter to list all APIs
          - Call anypoint_find_assets with a broad query to find Exchange assets
          - Set apps_found = total count of all apps returned
        
        CASE 3 — Input names BOTH an app AND an environment:
          - Call anypoint_list_applications with environmentName only (do NOT pass appName)
          - From the results, identify apps whose name closely matches the user's app input
          - Call anypoint_list_apis without name filter
          - Set apps_found = count of matched apps
        
        Do NOT make unnecessary API calls. Follow only the case that matches the input.
        
        Return JSON:
        {
          "apps": [{"name": "string", "environment": "string", "status": "string"}],
          "apis": [{"name": "string", "version": "string", "environment": "string", "asset_id": "string"}],
          "exchange_assets": [{"name": "string", "type": "string", "version": "string"}],
          "apps_found": "string",
          "apis_found": "string",
          "status": "string"
        }
    actions:
      anypoint_list_applications: @actions.anypoint_list_applications
      anypoint_list_apis: @actions.anypoint_list_apis
      anypoint_find_assets: @actions.anypoint_find_assets
      anypoint_get_api_details: @actions.anypoint_get_api_details
    outputs:
      properties:
        apps:
          type: "string"
          description: "JSON array of deployed applications found"
        apis:
          type: "string"
          description: "JSON array of APIs found in API Manager"
        exchange_assets:
          type: "string"
          description: "JSON array of Exchange assets found"
        apps_found:
          type: "string"
          description: "Count of apps found"
        apis_found:
          type: "string"
          description: "Count of APIs found"
        status:
          type: "string"
          description: "Scan status: success or failed"
  on_exit: ->
    transition to @router.anypointScanRouter

router anypointScanRouter:
  routes:
    - target: @echo.anypointScanSuccess
      when: @orchestrator.anypointScan.output.status == "success"
      label: "Anypoint Scan Succeeded"
  otherwise:
    target: @echo.anypointScanError

echo anypointScanSuccess:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("✅ Anypoint Platform MCP scan complete. Found " + @orchestrator.anypointScan.output.apps_found + " apps and " + @orchestrator.anypointScan.output.apis_found + " APIs. Proceeding to GitHub scan...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.githubScan

echo anypointScanError:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("⚠️ Anypoint Platform MCP call encountered issues. Continuing with partial data...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.githubScan

# ─── STEP 2: GitHub Scan ───────────────────────────────────────────────────

orchestrator githubScan:
  description: "Scan GitHub for Mule repositories, flows, and DataWeave files"
  label: "GitHub Scan"
  system:
    instructions: |
      You are Sherlock performing GitHub repository discovery.
      
      For each app found in Anypoint, search GitHub for matching repositories.
      If a specific app was mentioned in the original input, focus only on that app.
      - Use github_search_repos to find repos matching each app name
      - Use github_get_file_contents to read src/main/mule/, src/main/resources/dwl/, and README.md
      
      Do not perform unnecessary searches. Focus only on apps relevant to the user's request.
      Return JSON with all GitHub repositories and file findings.
  reasoning:
    instructions: ->
      | Perform GitHub scan for Mule repositories.
        
        Original input: {!@request.payload.message.parts[0].text}
        Anypoint apps discovered: {!@orchestrator.anypointScan.output.apps}
        
        SCOPING RULES:
        - Search GitHub repositories by app name only.
        - If only ONE app was discovered (apps_found = "1"), run a single targeted search:
            github_search_repos with query = "<app-name> language:Java"
            github_get_file_contents for README.md, src/main/mule/ and src/main/resources/dwl/
        - If MULTIPLE apps were discovered, run one github_search_repos per app name.
          Keep searches focused — do not search broadly.
        
        Do NOT search public repositories. Do NOT make unnecessary searches.
        Only search for apps in the Anypoint results above.
        
        FALLBACK RULE (IMPORTANT): If any GitHub tool call fails, returns an error, or returns
        no repositories, do NOT retry and do NOT report an error. Immediately return this
        exact static JSON so the flow can continue to the next step:
        {"repos": "[]", "repos_found": "0", "status": "success"}
        
        Return JSON:
        {
          "repos": "json-array-of-repos",
          "repos_found": "string",
          "status": "success or failed"
        }
    actions:
      github_search_repos: @actions.github_search_repos
      github_get_file_contents: @actions.github_get_file_contents
    outputs:
      properties:
        repos:
          type: "string"
          description: "JSON array of GitHub repos found with file details"
        repos_found:
          type: "string"
          description: "Count of repos found"
        status:
          type: "string"
          description: "Scan status: success or failed"
  on_exit: ->
    transition to @router.githubScanRouter

router githubScanRouter:
  routes:
    - target: @echo.githubScanSuccess
      when: @orchestrator.githubScan.output.status == "success"
      label: "GitHub Scan Succeeded"
  otherwise:
    target: @echo.githubScanError

echo githubScanSuccess:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("✅ GitHub MCP scan complete. Found " + @orchestrator.githubScan.output.repos_found + " repositories. Proceeding to GitBooks scan...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.gitbooksScan

echo githubScanError:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("⚠️ GitHub MCP call encountered issues. Continuing with partial data...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.gitbooksScan

# ─── STEP 3: GitBooks Scan ─────────────────────────────────────────────────

orchestrator gitbooksScan:
  description: "Scan GitBooks for existing documentation pages"
  label: "GitBooks Scan"
  system:
    instructions: |
      You are Sherlock performing GitBooks documentation discovery.
      
      DISCOVERY WORKFLOW (in order):
      1. Call gitbooks_list_organizations (operationId: "listOrganizationsForAuthenticatedUser")
         to dynamically resolve the organization ID — never hardcode it.
      2. Call gitbooks_list_sites with the discovered organizationId to get all sites.
      3. For each discovered app name, call gitbooks_search_content using operationId
         "searchOrganizationContent" with the app name as the search query. This directly
         returns matching pages with their spaceId and pageId — do NOT browse the hierarchy.
      4. Call gitbooks_get_page for each matched page to retrieve the full documentation.
      
      Prefer gitbooks_search_content over gitbooks_get_structure — search is faster and
      more reliable because page titles may not exactly match app names (e.g.,
      "Salesforce System API" matches query "salesforce-system-api").
      
      Return JSON with all GitBooks documentation found.
  reasoning:
    instructions: ->
      | Perform GitBooks documentation scan.
        
        Original input: {!@request.payload.message.parts[0].text}
        Anypoint apps discovered: {!@orchestrator.anypointScan.output.apps}
        
        STEP 1 — Discover org ID:
        - Call gitbooks_list_organizations with operationId = "listOrganizationsForAuthenticatedUser"
        - Extract the "id" field from the first item in the returned "items" array.
        
        STEP 2 — List sites:
        - Call gitbooks_list_sites with the discovered organizationId.
        
        STEP 3 — Search for each app:
        - For each app name in the Anypoint discovery results, call gitbooks_search_content with:
            operationId = "searchOrganizationContent"
            params = { "path": { "organizationId": "<discovered-org-id>" }, "query": { "query": "<app-name>" } }
        - From the results, extract spaceId and pageId for each matching page.
        - If only one app was discovered, run a single search for that app name.
        
        STEP 4 — Read matched pages:
        - Call gitbooks_get_page for each page returned by the search.
        - Do NOT use gitbooks_get_structure to browse the hierarchy unless search returns no results.
        
        Do NOT read every page. Only read pages relevant to the discovered apps.
        
        Return JSON:
        {
          "docs": [{"app_name": "string", "title": "string", "url": "string", "spaceId": "string", "pageId": "string", "summary": "string"}],
          "docs_found": "string",
          "status": "string"
        }
    actions:
      gitbooks_list_organizations: @actions.gitbooks_list_organizations
      gitbooks_search_content: @actions.gitbooks_search_content
      gitbooks_list_sites: @actions.gitbooks_list_sites
      gitbooks_get_structure: @actions.gitbooks_get_structure
      gitbooks_get_page: @actions.gitbooks_get_page
    outputs:
      properties:
        docs:
          type: "string"
          description: "JSON array of GitBooks documentation pages found"
        docs_found:
          type: "string"
          description: "Count of documentation pages found"
        status:
          type: "string"
          description: "Scan status: success or failed"
  on_exit: ->
    transition to @router.gitbooksScanRouter

router gitbooksScanRouter:
  routes:
    - target: @echo.gitbooksScanSuccess
      when: @orchestrator.gitbooksScan.output.status == "success"
      label: "GitBooks Scan Succeeded"
  otherwise:
    target: @echo.gitbooksScanError

echo gitbooksScanSuccess:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("✅ GitBooks MCP scan complete. Found " + @orchestrator.gitbooksScan.output.docs_found + " documentation pages. Proceeding to Linear task creation...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.linearCreation

echo gitbooksScanError:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("⚠️ GitBooks MCP call encountered issues. Continuing with partial data...")
    ]
  })
  on_exit: ->
    transition to @orchestrator.linearCreation

# ─── STEP 4: Linear Task Creation ─────────────────────────────────────────

orchestrator linearCreation:
  description: "Create Linear tracking tasks for all discovered apps"
  label: "Linear Task Creation"
  system:
    instructions: |
      You are Sherlock creating Linear tracking tasks for all discovered apps.
      
      - Use linear_list_teams to get available teams (pass limit="10")
      - For each app discovered, use linear_save_issue to create:
          title: "[KATE] Document: <App Name>"
          description: full markdown description with Anypoint, GitHub, and GitBooks findings
          team: first available team name
          priority: "3" (medium)
      - After creating each issue, use linear_save_comment to add individual finding comments:
          "Sherlock — API found: <name> v<version> in <environment>"
          "Sherlock — GitHub repo: <url> | Mule files: <n> | DataWeave files: <n>"
          "Sherlock — GitBooks doc found: <title> | <url>"
      
      Return the complete catalog JSON with linear issue IDs per app.
  reasoning:
    instructions: ->
      | Create Linear tasks for all discovered apps.
        
        Original input: {!@request.payload.message.parts[0].text}
        Anypoint apps: {!@orchestrator.anypointScan.output.apps}
        Anypoint APIs: {!@orchestrator.anypointScan.output.apis}
        GitHub repos: {!@orchestrator.githubScan.output.repos}
        GitBooks docs: {!@orchestrator.gitbooksScan.output.docs}
        
        SCOPING RULES:
        - Call linear_list_teams once to get the team list.
        - Create EXACTLY ONE Linear task per discovered app — no more.
        - If only one app was discovered (single-app scope), create exactly one task.
        - After creating each issue, add individual finding comments using linear_save_comment.
        - Do NOT create duplicate tasks. Check the app name before creating.
        
        Return JSON:
        {
          "apps": "json-array-of-apps-with-linear-ids",
          "total_apps": "string",
          "linear_team_name": "string",
          "catalog": "string",
          "status": "string"
        }
    actions:
      linear_list_teams: @actions.linear_list_teams
      linear_save_issue: @actions.linear_save_issue
      linear_save_comment: @actions.linear_save_comment
    outputs:
      properties:
        apps:
          type: "string"
          description: "JSON array of apps with Linear task IDs"
        catalog:
          type: "string"
          description: "Complete JSON asset catalog with Linear task IDs per app"
        total_apps:
          type: "string"
          description: "Total number of apps processed"
        linear_team_name:
          type: "string"
          description: "Linear team used for task creation"
        status:
          type: "string"
          description: "Task creation status: success or failed"
  on_exit: ->
    transition to @router.linearCreationRouter

router linearCreationRouter:
  routes:
    - target: @echo.linearCreationSuccess
      when: @orchestrator.linearCreation.output.status == "success"
      label: "Linear Tasks Created Successfully"
  otherwise:
    target: @echo.linearCreationError

echo linearCreationSuccess:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("✅ Linear MCP tasks created. " + @orchestrator.linearCreation.output.total_apps + " tasks created for team: " + @orchestrator.linearCreation.output.linear_team_name + ". Finalizing...")
    ]
  })
  on_exit: ->
    transition to @router.discoveryRouter

echo linearCreationError:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_WORKING"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("⚠️ Linear MCP task creation encountered issues. Partial tasks may have been created.")
    ]
  })
  on_exit: ->
    transition to @router.discoveryRouter

# ─── FINAL ROUTER ─────────────────────────────────────────────────────────

router discoveryRouter:
  routes:
    - target: @echo.discoverySuccess
      when: @orchestrator.linearCreation.output.status == "success"
      label: "Discovery Successful"
  otherwise:
    target: @echo.discoveryError

echo discoverySuccess:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("✅ Sherlock completed reconnaissance. Discovered " + @orchestrator.linearCreation.output.total_apps + " apps. Linear tasks created.\n\nTeam: " + @orchestrator.linearCreation.output.linear_team_name + "\n\nCatalog:\n" + @orchestrator.linearCreation.output.catalog)
    ]
  })

echo discoveryError:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_FAILED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart("❌ Sherlock encountered an error during discovery.\n\nAnypoint apps found: " + @orchestrator.anypointScan.output.apps_found + "\nGitHub repos found: " + @orchestrator.githubScan.output.repos_found + "\nGitBooks docs found: " + @orchestrator.gitbooksScan.output.docs_found + "\n\nPartial catalog: " + @orchestrator.linearCreation.output.catalog)
    ]
  })